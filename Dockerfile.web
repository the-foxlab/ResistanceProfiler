FROM node:22-alpine AS frontend-build

WORKDIR /app/web/frontend
COPY web/frontend/package.json ./
RUN npm install
COPY web/frontend/ ./
RUN npm run build

FROM python:3.12-slim AS runtime

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV RESPRO_WEB_HOST=0.0.0.0
ENV RESPRO_WEB_PORT=8000
ENV RESPRO_FRONTEND_DIST=/app/web/frontend/dist

RUN apt-get update && apt-get install -y --no-install-recommends build-essential python3-dev && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY respro ./respro
COPY web ./web

RUN pip install --no-cache-dir .
RUN pip install --no-cache-dir -r web/backend/requirements.txt
COPY --from=frontend-build /app/web/frontend/dist /app/web/frontend/dist

EXPOSE 8000
CMD ["python", "-m", "web.backend.main"]
