FROM node:24-alpine3.24 AS frontend-build

WORKDIR /app/web/frontend
COPY web/frontend/package.json web/frontend/package-lock.json ./
RUN npm ci
COPY web/frontend/ ./
RUN npm run build

FROM python:3.12.16-slim-trixie AS python-build

WORKDIR /app
ENV PIP_NO_CACHE_DIR=1 \
	PIP_DISABLE_PIP_VERSION_CHECK=1 \
	PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
	build-essential \
	python3-dev \
	libcairo2 \
	libpango-1.0-0 \
	libpangocairo-1.0-0 \
	libgdk-pixbuf-2.0-0 \
	libffi8 \
	shared-mime-info \
	fonts-dejavu-core \
	&& rm -rf /var/lib/apt/lists/*
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY pyproject.toml README.md ./
COPY respro ./respro
COPY web/__init__.py ./web/__init__.py
COPY web/backend ./web/backend

RUN pip install --upgrade pip setuptools wheel
RUN pip install .
RUN pip install -r web/backend/requirements.txt

FROM python:3.12.16-slim-trixie AS runtime

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV RESPRO_WEB_HOST=0.0.0.0
ENV RESPRO_WEB_PORT=8000
ENV MPLCONFIGDIR=/tmp/matplotlib
ENV XDG_CACHE_HOME=/tmp/cache
ENV PATH="/opt/venv/bin:$PATH"

RUN apt-get update && apt-get install -y --no-install-recommends \
	libcairo2 \
	libpango-1.0-0 \
	libpangocairo-1.0-0 \
	libgdk-pixbuf-2.0-0 \
	libffi8 \
	shared-mime-info \
	fonts-dejavu-core \
	gosu \
	&& rm -rf /var/lib/apt/lists/*

COPY --from=python-build /opt/venv /opt/venv
COPY --from=python-build /app/web/__init__.py /app/web/__init__.py
COPY --from=python-build /app/web/backend /app/web/backend
COPY --from=frontend-build /app/web/frontend/dist /app/web/frontend/dist

# ── Run as a non-root user ─────────────────────────────────────────
# Create a dedicated unprivileged user. /app and /opt/venv remain owned by
# root:root (read/execute only for `respro`) so the runtime process cannot
# modify application code. /data is owned by `respro` in the image, and the
# entrypoint repairs host bind-mount ownership on /data before dropping
# privileges via gosu.
RUN groupadd --system --gid 1001 respro \
    && useradd --system --uid 1001 --gid respro --home-dir /app --no-create-home respro \
    && mkdir -p /data \
    && chmod -R a+rX,go-w /app \
    && chown respro:respro /data

COPY docker/entrypoint.web.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8000
ENTRYPOINT ["/entrypoint.sh"]
CMD ["python", "-m", "web.backend.main"]
