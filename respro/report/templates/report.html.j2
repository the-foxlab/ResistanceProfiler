<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ context.title }}</title>
  <style>
    {{ css }}
  </style>
</head>
<body>
  <div class="report-container">
    <!-- Header -->
    <header class="report-header">
      <div class="header-top">
        <div class="header-main">
          <div class="header-title-group">
            <h1 class="header-title">{{ context.header.title }}</h1>
            <span class="header-badge {{ context.header.badge_class }}">
              {% if context.header.badge_icon == 'tick' %}&#10003;{% else %}x{% endif %}
              {{ context.header.badge_label }}
            </span>
          </div>
        </div>
        <div class="header-meta">
          <p>{{ context.header.meta_primary }}</p>
          <p class="header-meta-secondary">{{ context.header.meta_secondary }}</p>
        </div>
      </div>

      <!-- Tab Navigation -->
      <nav class="report-tabs">
        <div class="report-tabs-list">
          {% for tab in context.tabs %}
            <button class="tab-button {% if loop.first %}active{% endif %}" data-tab="{{ tab | lower | replace(' ', '-') }}">
              {{ tab }}
            </button>
          {% endfor %}
        </div>
        <div class="report-tabs-actions">
          <button id="plot-modal-open" class="tab-icon-button" type="button" aria-label="Open resistance plot">
            <img src="{{ context.header.picture_in_picture_icon }}" alt="Picture in picture icon">
          </button>
        </div>
      </nav>
    </header>

    <!-- Tab Content -->
    <main class="report-main">
      <div id="tab-summary" class="tab-content active">
        <p>Summary content (placeholder)</p>
      </div>
      <div id="tab-database-hits" class="tab-content">
        <p>Database hits content (placeholder)</p>
      </div>
      <div id="tab-all-mutations" class="tab-content">
        <p>All mutations content (placeholder)</p>
      </div>
      <div id="tab-sequence-features" class="tab-content">
        <p>Sequence features content (placeholder)</p>
      </div>
      <div id="tab-drugs" class="tab-content">
        <p>Drugs content (placeholder)</p>
      </div>
    </main>

    <div id="plot-modal" class="plot-modal" aria-hidden="true">
      <div id="plot-modal-backdrop" class="plot-modal-backdrop"></div>
      <section class="plot-modal-panel" role="dialog" aria-modal="true" aria-label="Resistance plot">
        <button id="plot-modal-close" class="plot-modal-close" type="button" aria-label="Close resistance plot">&times;</button>
        <div class="plot-modal-content">
          {% if context.plot.has_plot %}
            <img src="{{ context.plot.data_url }}" alt="Resistance plot" class="plot-modal-image">
          {% else %}
            <p class="plot-modal-empty">No plot available for this report.</p>
          {% endif %}
        </div>
      </section>
    </div>
  </div>

  <script>
    {{ js }}
  </script>
</body>
</html>
