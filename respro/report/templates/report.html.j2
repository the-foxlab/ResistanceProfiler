<!DOCTYPE html>
<html lang='en'>
<head>
<meta charset='utf-8'>
<meta name='viewport' content='width=device-width, initial-scale=1'>
<title>ResistanceProfiler - {{ summary.vcf }}</title>
<link rel='icon' type='image/svg+xml' href='{{ favicon_data_uri }}'>
<link rel='shortcut icon' href='{{ favicon_data_uri }}'>
<style>{{ css }}</style>
<style>
  .badge-missense { background: {{ mutation_colours['missense'] }}; color: #fff; }
  .badge-synonymous { background: {{ mutation_colours['synonymous'] }}; color: #fff; }
  .badge-nonsense { background: {{ mutation_colours['nonsense'] }}; color: #fff; }
  .badge-stop_gained { background: {{ mutation_colours['stop_gained'] }}; color: #fff; }
  .badge-stop_loss { background: {{ mutation_colours['stop_loss'] }}; color: #fff; }
  .badge-frameshift { background: {{ mutation_colours['frameshift'] }}; color: #fff; }
  .badge-insertion { background: {{ mutation_colours['insertion'] }}; color: #fff; }
  .badge-deletion { background: {{ mutation_colours['deletion'] }}; color: #fff; }
</style>
</head>
<body>
<div class='report-header'>
  <div class='logo-wrap'>{{ logo_svg | safe }}</div>
  <div class='github-links'>
    <a class='github-icon-link' href='https://github.com/jonas-fuchs/ResistanceProfiler' target='_blank' rel='noopener' title='ResistanceProfiler on GitHub'>
      <svg height='44' viewBox='0 0 16 16' width='44' aria-hidden='true'>
        <path fill='currentColor' d='M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z'/>
      </svg>
    </a>
  </div>
</div>

<dl class='meta'>
  <dt>Database</dt><dd>{{ summary.project_name }}</dd>
  <dt>Organism</dt><dd>{{ summary.organism or '-' }}</dd>
  <dt>Reference</dt><dd>{{ summary.reference }}</dd>
  <dt>Sample</dt><dd>{{ summary.sample or '-' }}</dd>
  <dt>File name</dt><dd>{{ summary.vcf }}</dd>
  <dt>Timestamp</dt><dd>{{ summary.timestamp }}</dd>
</dl>

<div class='stats'>
  <a class='stat-card' href='#section-cds'>
    <div class='number'>{{ summary.total_variants }}</div>
    <div class='label'>Total variants</div>
  </a>
  <a class='stat-card' href='#section-cds'>
    <div class='number'>{{ summary.variants_in_cds }}</div>
    <div class='label'>In CDS</div>
  </a>
  {% if summary.missense_count %}
  <a class='stat-card' href='#section-cds'>
    <div class='number'>{{ summary.missense_count }}</div>
    <div class='label'>Missense variants</div>
  </a>
  {% endif %}
   {% if summary.high_impact_count %}
  <a class='stat-card warn' href='#section-cds'>
    <div class='number'>&#9888; {{ summary.high_impact_count }}</div>
    <div class='label'>High-impact variants</div>
    <div class='stat-note'>frameshift &middot; stop &middot; indel</div>
  </a>
  {% endif %}
  <a class='stat-card hit' href='#section-db-hits'>
    <div class='number'>{{ summary.database_hits }}</div>
    <div class='label'>Database hits</div>
    {% if summary.database_hits %}
    <div class='stat-sub'>
      <span class='stat-pill resistant{{ ' zero' if not summary.resistant_hits }}'>Resistant: {{ summary.resistant_hits }}</span>
      <span class='stat-pill intermediate{{ ' zero' if not summary.intermediate_hits }}'>Intermediate: {{ summary.intermediate_hits }}</span>
      <span class='stat-pill sensitive{{ ' zero' if not summary.sensitive_hits }}'>Sensitive: {{ summary.sensitive_hits }}</span>
    </div>
    {% endif %}
  </a>
  <a class='stat-card' href='#section-similarity'>
    <div class='number'>{{ summary.similarity_hits }}</div>
    <div class='label'>Similarity hits</div>
    {% if summary.similarity_hits %}
    <div class='stat-sub'>
      <span class='stat-pill resistant{{ ' zero' if not summary.similarity_resistant }}'>Resistant: {{ summary.similarity_resistant }}</span>
      <span class='stat-pill intermediate{{ ' zero' if not summary.similarity_intermediate }}'>Intermediate: {{ summary.similarity_intermediate }}</span>
      <span class='stat-pill sensitive{{ ' zero' if not summary.similarity_sensitive }}'>Sensitive: {{ summary.similarity_sensitive }}</span>
    </div>
    {% endif %}
  </a>
</div>

{% if plot_data %}
<div class='section open'>
<h2 class='section-toggle'>Mutation overview <span class='toggle-arrow'>&#9654;</span></h2>
<div class='section-body'>
<div class='plot-container'>
  <img src='data:image/svg+xml;base64,{{ plot_data }}' alt='Lollipop plot'>
</div>
</div>
</div>
{% endif %}

{% if db_hit_rows %}
<div class='section open' id='section-db-hits'>
<h2 class='section-toggle'>Mutations in database <span class='toggle-arrow'>&#9654;</span></h2>
<div class='section-body'>
<div class='table-wrapper'>
<table class='sortable'>
<thead><tr>
  <th>Gene</th><th>AA change</th><th>Frequency classification</th><th>Underlying nt change</th><th>Drug</th>
  {% if db_cols.ic50 %}<th>IC50</th>{% endif %}
  {% if db_cols.fold_ic50 %}<th>Fold-IC50</th>{% endif %}
  <th>Phenotype</th>
  {% if db_cols.clinical_phenotype %}<th>Clinical phenotype</th>{% endif %}
  {% if db_cols.source %}<th>Source</th>{% endif %}
  {% if db_cols.comment %}<th>Comment</th>{% endif %}
  {% if db_cols.publication %}<th>Ref</th>{% endif %}
</tr></thead>
<tbody>
{% for r in db_hit_rows %}
<tr class='hit-row' style='border-left: 4px solid {{ mutation_colours.get(r.consequence, mutation_colours['unknown']) }};'>
  <td>{{ r.gene }}</td>
  <td><strong>{{ r.aa_change }}</strong></td>
  <td data-sort-value='{{ r.af_bin }}'><span class='badge badge-{{ r.af_bin }}'>{{ r.af_bin }}</span></td>
  <td>{{ r.nt_change }}</td>
  <td>{{ r.drug }}</td>
  {% if db_cols.ic50 %}<td>{{ r.ic50 or '—' }}</td>{% endif %}
  {% if db_cols.fold_ic50 %}<td>{{ r.fold_ic50 or '—' }}</td>{% endif %}
  <td>{% if r.phenotype == 'resistant' %}<span class='badge badge-resistant'>resistant</span>
      {% elif r.phenotype == 'intermediate' %}<span class='badge badge-intermediate-p'>intermediate</span>
      {% elif r.phenotype == 'sensitive' %}<span class='badge badge-sensitive'>sensitive</span>
      {% else %}<span class='badge badge-unknown'>{{ r.phenotype }}</span>{% endif %}</td>
  {% if db_cols.clinical_phenotype %}
  <td>{% if r.clinical_phenotype == 'resistant' %}<span class='badge badge-resistant'>resistant</span>
      {% elif r.clinical_phenotype == 'intermediate' %}<span class='badge badge-intermediate-p'>intermediate</span>
      {% elif r.clinical_phenotype == 'sensitive' %}<span class='badge badge-sensitive'>sensitive</span>
      {% else %}<span class='badge badge-unknown'>{{ r.clinical_phenotype }}</span>{% endif %}</td>
  {% endif %}
  {% if db_cols.source %}<td>{{ r.source or '—' }}</td>{% endif %}
  {% if db_cols.comment %}<td>{{ r.comment or '—' }}</td>{% endif %}
  {% if db_cols.publication %}<td>{% for n in r.pub_citations %}<a href='#ref-{{ n }}'>[{{ n }}]</a> {% endfor %}</td>{% endif %}
</tr>
{% endfor %}
</tbody>
</table>
</div>
</div>
</div>
{% endif %}

{% if combo_hit_rows %}
<div class='section open'>
<h2 class='section-toggle'>Combination rule hits <span class='toggle-arrow'>&#9654;</span></h2>
<div class='section-body'>
<div class='table-wrapper'>
<table class='sortable'>
<thead><tr>
  <th>Group</th><th>Member mutations</th><th>Drug</th>
  {% if combo_cols.ic50 %}<th>IC50</th>{% endif %}
  {% if combo_cols.fold_ic50 %}<th>Fold-IC50</th>{% endif %}
  <th>Phenotype</th>
  {% if combo_cols.clinical_phenotype %}<th>Clinical phenotype</th>{% endif %}
  {% if combo_cols.comment %}<th>Comment</th>{% endif %}
  {% if combo_cols.publication %}<th>Ref</th>{% endif %}
</tr></thead>
<tbody>
{% for r in combo_hit_rows %}
<tr class='hit-row'>
  <td>{{ r.group_name }}</td>
  <td>{{ r.members }}</td>
  <td>{{ r.drug }}</td>
  {% if combo_cols.ic50 %}<td>{{ r.ic50 or '—' }}</td>{% endif %}
  {% if combo_cols.fold_ic50 %}<td>{{ r.fold_ic50 or '—' }}</td>{% endif %}
  <td>{% if r.phenotype == 'resistant' %}<span class='badge badge-resistant'>resistant</span>
      {% elif r.phenotype == 'intermediate' %}<span class='badge badge-intermediate-p'>intermediate</span>
      {% elif r.phenotype == 'sensitive' %}<span class='badge badge-sensitive'>sensitive</span>
      {% else %}<span class='badge badge-unknown'>{{ r.phenotype }}</span>{% endif %}</td>
  {% if combo_cols.clinical_phenotype %}
  <td>{% if r.clinical_phenotype == 'resistant' %}<span class='badge badge-resistant'>resistant</span>
      {% elif r.clinical_phenotype == 'intermediate' %}<span class='badge badge-intermediate-p'>intermediate</span>
      {% elif r.clinical_phenotype == 'sensitive' %}<span class='badge badge-sensitive'>sensitive</span>
      {% else %}<span class='badge badge-unknown'>{{ r.clinical_phenotype }}</span>{% endif %}</td>
  {% endif %}
  {% if combo_cols.comment %}<td>{{ r.comment or '—' }}</td>{% endif %}
  {% if combo_cols.publication %}<td>{% for n in r.pub_citations %}<a href='#ref-{{ n }}'>[{{ n }}]</a> {% endfor %}</td>{% endif %}
</tr>
{% endfor %}
</tbody>
</table>
</div>
</div>
</div>
{% endif %}

{% if potential_rows %}
<div class='section open' id='section-similarity'>
<h2 class='section-toggle'>Similarity to database entries <span class='toggle-arrow'>&#9654;</span></h2>
<div class='section-body'>
<p class='table-note'>Detected mutations at positions with known resistance rules but different amino acid changes. Similarity is scored with BLOSUM62.</p>
<div class='table-wrapper'>
<table class='sortable'>
<thead><tr>
  <th>Gene</th><th>Observed AA change</th><th>Known rule</th><th>Similarity</th><th>Drug</th>
  {% if pot_cols.ic50 %}<th>IC50</th>{% endif %}
  {% if pot_cols.fold_ic50 %}<th>Fold-IC50</th>{% endif %}
  <th>Phenotype</th>
  {% if pot_cols.clinical_phenotype %}<th>Clinical phenotype</th>{% endif %}
  {% if pot_cols.source %}<th>Source</th>{% endif %}
  {% if pot_cols.comment %}<th>Comment</th>{% endif %}
  <th>Frequency</th>{% if pot_cols.publication %}<th>Ref</th>{% endif %}
</tr></thead>
<tbody>
{% for r in potential_rows %}
<tr>
  <td>{{ r.gene }}</td>
  <td><strong>{{ r.observed_change }}</strong></td>
  <td>{{ r.rule_change }}</td>
  <td><span class='badge badge-sim-{{ r.similarity }}'>{{ r.similarity }}</span></td>
  <td>{{ r.drug }}</td>
  {% if pot_cols.ic50 %}<td>{{ r.ic50 or '—' }}</td>{% endif %}
  {% if pot_cols.fold_ic50 %}<td>{{ r.fold_ic50 or '—' }}</td>{% endif %}
  <td>{% if r.phenotype == 'resistant' %}<span class='badge badge-resistant'>resistant</span>
      {% elif r.phenotype == 'intermediate' %}<span class='badge badge-intermediate-p'>intermediate</span>
      {% elif r.phenotype == 'sensitive' %}<span class='badge badge-sensitive'>sensitive</span>
      {% else %}<span class='badge badge-unknown'>{{ r.phenotype }}</span>{% endif %}</td>
  {% if pot_cols.clinical_phenotype %}
  <td>{% if r.clinical_phenotype == 'resistant' %}<span class='badge badge-resistant'>resistant</span>
      {% elif r.clinical_phenotype == 'intermediate' %}<span class='badge badge-intermediate-p'>intermediate</span>
      {% elif r.clinical_phenotype == 'sensitive' %}<span class='badge badge-sensitive'>sensitive</span>
      {% else %}<span class='badge badge-unknown'>{{ r.clinical_phenotype }}</span>{% endif %}</td>
  {% endif %}
  {% if pot_cols.source %}<td>{{ r.source or '—' }}</td>{% endif %}
  {% if pot_cols.comment %}<td>{{ r.comment or '—' }}</td>{% endif %}
  <td data-sort-value='{{ '%.6f'|format(r.allele_freq) }}'>{{ '%.3f'|format(r.allele_freq) }}</td>
  {% if pot_cols.publication %}<td>{% for n in r.pub_citations %}<a href='#ref-{{ n }}'>[{{ n }}]</a> {% endfor %}</td>{% endif %}
</tr>
{% endfor %}
</tbody>
</table>
</div>
</div>
</div>
{% endif %}

<div class='section' id='section-cds'>
<h2 class='section-toggle'>All CDS variants <span class='toggle-arrow'>&#9654;</span></h2>
<div class='section-body'>
<div class='table-wrapper'>
<table class='sortable'>
<thead><tr>
  <th>Gene</th><th>Nt change</th><th>AA change</th><th>Consequence</th><th>Frequency</th><th>Frequency classification</th><th>In database</th>
</tr></thead>
<tbody>
{% for r in cds_rows %}
<tr class='{{ 'hit-row' if r.database_hit else '' }}'>
  <td>{{ r.gene }}</td>
  <td>{{ r.nt_change }}</td>
  <td>{% if r.aa_change %}{{ r.aa_change }}{% endif %}</td>
  <td><span class='badge badge-{{ r.consequence }}'>{{ r.consequence }}</span></td>
  <td data-sort-value='{{ '%.6f'|format(r.allele_freq) }}'>{{ '%.3f'|format(r.allele_freq) }}</td>
  <td data-sort-value='{{ r.af_bin }}'><span class='badge badge-{{ r.af_bin }}'>{{ r.af_bin }}</span></td>
  <td data-sort-value='{{ 1 if r.database_hit else 0 }}'><span class='db-indicator {{ 'db-yes' if r.database_hit else 'db-no' }}' title='{{ 'Yes' if r.database_hit else 'No' }}' aria-label='{{ 'Yes' if r.database_hit else 'No' }}'></span></td>
</tr>
{% endfor %}
</tbody>
</table>
</div>
</div>
</div>

{% if gene_cards %}
<div class='section'>
<h2 class='section-toggle'>Gene overview <span class='toggle-arrow'>&#9654;</span></h2>
<div class='section-body'>
<div class='gene-cards'>
{% for g in gene_cards %}
<div class='gene-card'>
  <div class='gene-meta-block'>
    <div class='gene-name'>{{ g.name }}</div>
    <div><strong>Product:</strong> {{ g.protein or '-' }}</div>
    <div><strong>Protein ID:</strong> {{ g.protein_id or '-' }}</div>
    <div><strong>Locus tag:</strong> {{ g.locus_tag or '-' }}</div>
    {% if g.note %}<div class='gene-note'><strong>Note:</strong> {{ g.note }}</div>{% endif %}
    {% if g.ncbi_protein_url %}<a href='{{ g.ncbi_protein_url }}' target='_blank'>NCBI protein ↗</a>{% endif %}
  </div>
  <div class='gene-seq-block'>
    <pre class='gene-seq'>{% if g.protein_id %}>{{ g.protein_id }}{% else %}>{{ g.name }}{% endif %}
{{ g.aa_sequence or '-' }}</pre>
  </div>
</div>
{% endfor %}
</div>
</div>
</div>
{% endif %}

{% if drug_cards %}
<div class='section'>
<h2 class='section-toggle'>Drug overview <span class='toggle-arrow'>&#9654;</span></h2>
<div class='section-body'>
<div class='drug-cards'>
{% for d in drug_cards %}
<div class='drug-card'>
  {% if d.structure_url %}<img src='{{ d.structure_url }}' alt='{{ d.name }} structure'>{% endif %}
  <div class='drug-info'>
    <div class='drug-name'>{{ d.name }}</div>
    {% if d.description %}<div class='drug-desc'>{{ d.description }}</div>{% endif %}
    {% if d.pubchem_url %}<a href='{{ d.pubchem_url }}' target='_blank'>PubChem ↗</a>{% endif %}
  </div>
</div>
{% endfor %}
</div>
</div>
</div>
{% endif %}

{% if bibliography %}
<div class='section'>
<h2 class='section-toggle'>References <span class='toggle-arrow'>&#9654;</span></h2>
<div class='section-body'>
<ol class='bibliography'>
{% for pub in bibliography %}
<li id='ref-{{ pub.citation_num }}'>
  {% if pub.title %}<em>{{ pub.title }}</em>{% else %}<span>{{ pub.raw_input or pub.doi }}</span>{% endif %}
  {% if pub.doi %} — <a href='https://doi.org/{{ pub.doi }}' target='_blank' rel='noopener'>DOI ↗</a>{% endif %}
  {% if pub.pubmed_id %} <a href='https://pubmed.ncbi.nlm.nih.gov/{{ pub.pubmed_id }}/' target='_blank' rel='noopener'>PubMed ↗</a>{% endif %}
</li>
{% endfor %}
</ol>
</div>
</div>
{% endif %}

<footer>Generated by <strong>ResistanceProfiler v{{ version }}</strong> on {{ summary.timestamp }}.</footer>

<script>{{ js | safe }}</script>
</body>
</html>

