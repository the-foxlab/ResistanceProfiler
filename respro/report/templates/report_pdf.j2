<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ context.title }}</title>
  <style>{{ print_css }}</style>
</head>
<body>
  <div class="page">
    <header class="report-header">
      <div class="header-main">
        <h1 class="header-title">{{ context.header.title }}</h1>
        <span class="header-version">respro v{{ context.header.version }}</span>
      </div>
      <p class="header-meta">{{ context.header.meta_primary }}</p>
      <p class="header-meta header-meta-secondary">{{ context.header.meta_secondary }}</p>
    </header>

    <section class="section section-summary-grid">
      <div class="summary-grid">
        <article class="list-card panel">
          <div class="subsection-title">Sequence Assessment</div>
          <ul class="kv-list">
            {% for item in context.summary.sequence_items %}
            <li><span class="kv-label">{{ item.label }}</span><span class="kv-value">{{ item.value }}</span></li>
            {% endfor %}
          </ul>
        </article>

        <article class="list-card panel">
          <div class="subsection-title">Database Assessment</div>
          <ul class="kv-list">
            {% for item in context.summary.database_items %}
            <li><span class="kv-label">{{ item.label }}</span><span class="kv-value">{{ item.value }}</span></li>
            {% endfor %}
          </ul>
        </article>
      </div>
    </section>

    <section class="section section-features">
      <div class="section-title">Sequence Features and Mutation Profile</div>
      <article class="panel">
        {% if context.summary.mutation_profile %}
        <ul class="feature-list">
          {% for entry in context.summary.mutation_profile %}
          <li class="feature-row">
            <span class="feature-name">{{ entry.feature }}</span>
            <span class="feature-cov">{% if context.summary.has_coverage and entry.covered_pct is not none %}({{ entry.covered_pct }}% covered){% endif %}</span>
            <span class="feature-muts">
              {% for m in entry.mutations %}
              <span class="mut-chip{% if m.is_high_impact %} mut-chip--high{% elif m.is_db_hit %} mut-chip--hit{% endif %}">{{ m.label }}</span>{% if not loop.last %}, {% endif %}
              {% endfor %}
            </span>
          </li>
          {% endfor %}
        </ul>
        {% else %}
        <p class="empty">No CDS variants were found.</p>
        {% endif %}
      </article>
    </section>

    <section class="section section-drug-summary">
      <div class="section-title">Drug Summary</div>
      <p class="drug-summary-text">{{ context.summary.narrative | safe }}</p>
      <article class="panel">
        {% if context.summary.drug_rows %}
        <table class="drug-table">
          <colgroup>
            {% if context.summary.has_drug_class and context.summary.has_assessment %}
            <col class="col-class" />
            <col class="col-drug" />
            <col class="col-hits" />
            {% for ml in context.summary.method_labels %}
            <col class="col-assessment" />
            {% endfor %}
            <col class="col-assessment" />
            {% elif context.summary.has_drug_class %}
            <col class="col-class" />
            <col class="col-drug-wide" />
            <col class="col-hits" />
            {% elif context.summary.has_assessment %}
            <col class="col-drug-widest" />
            <col class="col-hits" />
            {% for ml in context.summary.method_labels %}
            <col class="col-assessment" />
            {% endfor %}
            <col class="col-assessment" />
            {% else %}
            <col class="col-drug-widest" />
            <col class="col-hits-wide" />
            {% endif %}
          </colgroup>
          <thead>
            <tr>
              {% if context.summary.has_drug_class %}
              <th>Class</th>
              {% endif %}
              <th>Drug</th>
              <th>Hits</th>
              {% if context.summary.has_assessment %}
              {% for ml in context.summary.method_labels %}
              <th>{{ ml.label }}</th>
              {% endfor %}
              <th>Assessment</th>
              {% endif %}
            </tr>
          </thead>
          <tbody>
            {% for row in context.summary.drug_rows %}
            <tr>
              {% if context.summary.has_drug_class %}
              <td class="drug-class">{{ row.drug_class or '—' }}</td>
              {% endif %}
              <td class="drug-name">{{ row.name }}</td>
              <td class="drug-count">{{ row.hit_count }}</td>
              {% if context.summary.has_assessment %}
              {% for ml in context.summary.method_labels %}
              <td>{{ row.method_assessments_by_method.get(ml.method, '') or '—' }}</td>
              {% endfor %}
              <td>
                <span class="assessment {{ row.assessment_badge_class }}">{{ row.assessment }}</span>
              </td>
              {% endif %}
            </tr>
            {% endfor %}
          </tbody>
        </table>
        {% else %}
        <p class="empty">No drug interpretation rows available.</p>
        {% endif %}
      </article>
    </section>
  </div>
</body>
</html>
